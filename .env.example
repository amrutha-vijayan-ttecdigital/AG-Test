# Google Cloud Connection Details
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us

# CX Agent Studio Configuration
# The app id (a.k.a. steering agent) from the console URL: .../apps/<this>
# CES_APP_ID is an accepted alias; either resolves to the apps/{app} path.
CES_AGENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# A deployment id under the app. Needed by ces-deploy rollback targeting and by
# ces-eval/ces-voice-test when testing a cut version instead of the draft.
CES_DEPLOYMENT_ID=

# Optional: gcloud account used to mint API tokens (defaults to the active one).
# CES_USER=you@your-domain.com
# Optional: CES REST host override (defaults to ces.googleapis.com).
# CES_API_HOST=ces.googleapis.com

# Developer Details
DEVELOPER_EMAIL=your.email@domain.com

# --- Optional: ces-* operations skills ---------------------------------------
# OpenAPI toolset auth (ces-sync). Default is the CES service-agent OIDC token,
# right for private Cloud Run / IAP backends. Set these for OAuth2 instead:
# CES_TOOLSET_OAUTH_CLIENT_ID=
# CES_TOOLSET_OAUTH_SECRET_VERSION=
# CES_TOOLSET_OAUTH_TOKEN_URL=
# CES_TOOLSET_OAUTH_SCOPE=
# Voice runner (ces-voice-test): TTS engine + audio cache dir.
# CES_VOICE_TTS=auto            # auto | google | gtts | say
# CES_VOICE_AUDIO_CACHE=        # defaults to the OS temp dir

# Optional Lucid integration for .agents/skills/gemini/*
# Either name is accepted by bundled scripts.
LUCID_API_KEY=
LUCID_TOKEN=

# Optional Jira integration for design-audit workflows.
JIRA_SITE=your-domain.atlassian.net
JIRA_USER=
JIRA_TOKEN=
JIRA_PROJECT=YOUR_PROJECT_KEY

# Optional PractiTest integration for test results
PRACTITEST_API_KEY=
PRACTITEST_PROJECT_ID=
PRACTITEST_FILTER_ID=
PRACTITEST_EMAIL=
